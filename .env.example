# Disney Navoiy Hisobot Bot — sozlamalar namunasi
# Bu faylni ".env" nomi bilan nusxalab, qiymatlarni to'ldiring.

# BotFather'dan olingan token
BOT_TOKEN=

# Anthropic (Claude) API kaliti — botning javob matnlarini AI shu orqali yozadi.
# Bo'sh qoldirsangiz AI o'chadi va bot texts.py dagi zaxira shablonlar bilan ishlaydi.
ANTHROPIC_API_KEY=

# AI modeli. Standart: claude-opus-5 (eng sifatli javoblar).
# Arzonroq variant: claude-sonnet-5
AI_MODEL=claude-opus-5

# Admin Telegram ID raqami (faqat shu odam admin komandalarini ishlata oladi)
ADMIN_ID=

# Baza fayli joylashuvi
DB_PATH=data/bot.db

# Vaqt mintaqasi — barcha jadval vaqtlari shu zonada hisoblanadi
TIMEZONE=Asia/Tashkent

# Log darajasi: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
