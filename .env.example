# Disney Navoiy Hisobot Bot — sozlamalar namunasi
# Bu faylni ".env" nomi bilan nusxalab, qiymatlarni to'ldiring.

# BotFather'dan olingan token
BOT_TOKEN=

# Anthropic (Claude) API kaliti — 2-bosqichda AI tekshiruv uchun
ANTHROPIC_API_KEY=

# Admin Telegram ID raqami (faqat shu odam admin komandalarini ishlata oladi)
ADMIN_ID=

# Baza fayli joylashuvi (Turso ISHLATILMASA — lokal SQLite fayli)
DB_PATH=data/bot.db

# Turso (bulutdagi libSQL) — bo'sh bo'lsa lokal DB_PATH ishlatiladi.
# To'ldirilsa, ma'lumot bulutда saqlanadi (ephemeral hostlarда ham yo'qolmaydi).
# Turso panelидан olinadi:  turso db show <nom> --url   va   turso db tokens create <nom>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vaqt mintaqasi — barcha jadval vaqtlari shu zonada hisoblanadi
TIMEZONE=Asia/Tashkent

# Log darajasi: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
